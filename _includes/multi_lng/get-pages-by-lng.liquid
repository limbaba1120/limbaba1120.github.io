{%-comment-%} out: lng_pages {%-endcomment-%}

{%- include multi_lng/get-lng-by-url.liquid -%}
{%- assign current_page_lng = page.lang | default: get_lng -%}
{%- assign lng = current_page_lng -%}
{%- comment -%} create an empty array {%- endcomment -%}
{%- assign lng_pages = '' | split: '' -%}
{%- for lng_page in include.pages -%}
  {%- include multi_lng/get-lng-by-url.liquid url = lng_page.url -%}
  {%- assign candidate_lng = lng_page.lang | default: get_lng -%}
  {%- if candidate_lng != current_page_lng -%}{%- continue -%}{%- endif -%}
  {%- assign lng_pages = lng_pages | push: lng_page -%}
{%- endfor -%}
